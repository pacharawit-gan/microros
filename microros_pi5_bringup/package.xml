<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>microros_pi5_bringup</name>
  <version>0.1.0</version>
  <description>
    Bringup for the Yahboom MicroROS-Pi5 4WD car: odometry/TF republishing from the ESP32
    microROS control board, wheel joint states, cmd_vel rate limiting and safety timeout,
    and the launch files that tie them to the robot description.
  </description>
  <maintainer email="akeeslatun@gmail.com">pacharawit</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>microros_pi5_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Optional at runtime; each is gated behind a launch argument that defaults to false
       so that a stock `ros2 launch ... bringup.launch.py` works without them installed. -->
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
