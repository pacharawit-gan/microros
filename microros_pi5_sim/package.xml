<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>microros_pi5_sim</name>
  <version>0.1.0</version>
  <description>
    Kinematic simulation for the MicroROS-Pi5 car. Replaces the ESP32 control board with a
    node that obeys /cmd_vel and reports /odom_raw + /imu, so the whole bringup stack can be
    driven and debugged without the robot.
  </description>
  <maintainer email="akeeslatun@gmail.com">pacharawit</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>microros_pi5_bringup</exec_depend>
  <exec_depend>microros_pi5_description</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
